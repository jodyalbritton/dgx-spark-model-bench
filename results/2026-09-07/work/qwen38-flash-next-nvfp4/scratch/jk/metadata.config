{<<"links">>,[{<<"GitHub">>,<<"https://github.com/jobycorp/joby_kit">>}]}.
{<<"name">>,<<"joby_kit">>}.
{<<"version">>,<<"0.3.3">>}.
{<<"description">>,
 <<"An opinionated, agentic-first design-system kit for Phoenix + daisyUI.\nShips a component manifest, a /design page, a /design.json endpoint for\nAI agents, contract-clean core wrappers, a wrapper-contract linter, and\nmix tasks for installing into existing apps or generating new ones.">>}.
{<<"elixir">>,<<"~> 1.16">>}.
