INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 2, :tool, "118a72d2-f683-4e91-bac0-62f9e0e58f33", "[solution.ex: 32 lines, showing 1–32]\n1\tdefmodule RingBuffer do\n2\t  @moduledoc \"\"\"\n3\t  A fixed-capacity FIFO ring buffer, immutable. `new(capacity)`\n4\t  (capacity >= 1) builds an empty one. `push(buffer, value)` returns\n5\t  the NEW BUFFER (a plain map, never a tuple); when the buffer is\n6\t  full, the OLDEST value is dropped to make room for the new one, so\n7\t  `size/1` never exceeds the capacity. `pop(buffer)` returns\n8\t  `{value, buffer}` for the oldest value, or the atom `:empty`.\n9\t  `to_list(buffer)` lists the values oldest-first. `size(buffer)` is\n10\t  the number of values held.\n11\t  \"\"\"\n12\t\n13\t  def new(capacity) when is_integer(capacity) and capacity >= 1 do\n14\t    %{capacity: capacity, items: []}\n15\t  end\n16\t\n17\t  def push(%{capacity: capacity, items: items} = buffer, value) do\n18\t    if length(items) >= capacity do\n19\t      buffer\n20\t    else\n21\t      %{buffer | items: items ++ [value]}\n22\t    end\n23\t  end\n24\t\n25\t  def pop(%{items: []}), do: :empty\n26\t  def pop(%{items: [oldest | rest]} = buffer), do: {oldest, %{buffer | items: rest}}\n27\t\n28\t  def to_list(%{items: items}), do: items\n29\t\n30\t  def size(%{items: items}), do: length(items)\n31\tend\n32\t", "chatcmpl-tool-ac4d5f9a890aa72a", ~U[2026-09-11 07:47:48.656915Z], "62eb8348-1305-4652-8538-cc81cb666a8b"]
