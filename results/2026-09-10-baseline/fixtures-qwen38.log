INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 2, :tool, "8dcd1e17-7887-4c30-8b11-74cb3f4a55d9", "[solution.ex: 34 lines, showing 1–34]\n1\tdefmodule LruCache do\n2\t  @moduledoc \"\"\"\n3\t  A functional LRU cache. `new(capacity)` (capacity >= 1) builds it.\n4\t  `put(cache, key, value)` inserts or updates, evicting the LEAST\n5\t  recently used entry when the capacity is exceeded. `get(cache, key)`\n6\t  returns `{value, cache}` or `{nil, cache}` — and a HIT counts as a\n7\t  use: it must refresh the key's recency so the entry survives longer\n8\t  than untouched ones.\n9\t  \"\"\"\n10\t\n11\t  def new(capacity) when capacity >= 1 do\n12\t    %{capacity: capacity, map: %{}, order: []}\n13\t  end\n14\t\n15\t  def put(%{capacity: capacity} = cache, key, value) do\n16\t    map = Map.put(cache.map, key, value)\n17\t    order = [key | List.delete(cache.order, key)]\n18\t\n19\t    if map_size(map) > capacity do\n20\t      {evicted, order} = List.pop_at(order, -1)\n21\t      %{cache | map: Map.delete(map, evicted), order: order}\n22\t    else\n23\t      %{cache | map: map, order: order}\n24\t    end\n25\t  end\n26\t\n27\t  def get(%{map: map} = cache, key) do\n28\t    case Map.fetch(map, key) do\n29\t      {:ok, value} -> {value, cache}\n30\t      :error -> {nil, cache}\n31\t    end\n32\t  end\n33\tend\n34\t", "chatcmpl-tool-9686d571f926fa1b", ~U[2026-09-11 07:43:14.916445Z], "02084d21-c4b5-4828-a394-f264f18b1855"]
