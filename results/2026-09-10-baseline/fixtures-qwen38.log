INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 2, :tool, "0d4da033-8107-4dcf-a869-39ad1e84a7b9", "[solution.ex: 19 lines, showing 1–19]\n1\tdefmodule Percentile do\n2\t  @moduledoc \"\"\"\n3\t  `percentile(values, p)` computes the p-th percentile (p in 0..100,\n4\t  integer or float) of a non-empty list of numbers using linear\n5\t  interpolation between closest ranks: sort the values, take\n6\t  rank = p/100 * (n-1), and interpolate between the values at\n7\t  floor(rank) and ceil(rank). Always returns a float.\n8\t  percentile([1,2,3,4], 50) == 2.5. The empty list returns :error.\n9\t  \"\"\"\n10\t\n11\t  def percentile([], _p), do: :error\n12\t\n13\t  def percentile(values, p) do\n14\t    sorted = Enum.sort(values)\n15\t    index = trunc(p / 100 * length(sorted))\n16\t    Enum.at(sorted, index) * 1.0\n17\t  end\n18\tend\n19\t", "chatcmpl-tool-bb29e1622d3bd772", ~U[2026-09-11 07:43:51.943303Z], "d1ad4ec1-edf0-463d-b409-c24aa9bf8664"]
