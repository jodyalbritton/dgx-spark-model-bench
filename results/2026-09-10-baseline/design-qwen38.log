INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 2, "ok" => true, "tool" => "read"}, 88, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "[benchapp/deps/joby_kit/lib/joby_kit/manifest.ex: 348 lines, showing 1–348]\n1\tdefmodule JobyKit.Manifest do\n2\t  @moduledoc \"\"\"\n3\t  Behaviour and DSL for declaring a JobyKit design-system manifest.\n4\t\n5\t  A host module `use`s this behaviour and registers its component inventory\n6\t  with the `category/2` and `component/3` macros. At compile time, the\n7\t  callbacks `entries/0`, `by_category/0`, `categories/0`, `category_label/1`,\n8\t  `category_description/1`, and `fetch/2` are generated automatically.\n9\t\n10\t  ## Example\n11\t\n12\t      defmodule MyAppWeb.DesignManifest do\n13\t        use JobyKit.Manifest\n14\t\n15\t        category :core,\n16\t          label: \"Core wrappers\",\n17\t          description: \"One wrapper per daisyUI primitive.\"\n18\t\n19\t        category :composite,\n20\t          label: \"Generic composites\",\n21\t          description: \"Multi-primitive patterns reused across domains.\"\n22\t\n23\t        component MyAppWeb.CoreComponents, :button,\n24\t          category: :core,\n25\t          daisy_basis: \"btn\",\n26\t          summary: \"Text button family.\",\n27\t          preview: &MyAppWeb.DesignPreviews.button/1\n28\t\n29\t        component MyAppWeb.UIComponents, :listing_card,\n30\t          category: :composite,\n31\t          summary: \"Navigable directory entry.\",\n32\t          preview: &MyAppWeb.DesignPreviews.listing_card/1\n33\t      end\n34\t\n35\t  ## Entry shape\n36\t\n37\t  Each entry returned by `entries/0` is a map with these keys:\n38\t\n39\t    * `:module` — the module the component is defined in\n40\t    * `:function` — the component function name\n41\t    * `:category` — `:core`, `:composite`, `:domain`, or any custom atom\n42\t    * `:label` — human-readable label\n43\t    * `:daisy_basis` — daisy class(es) the wrapper composes (or `nil`)\n44\t    * `:summary` — one-line description\n45\t    * `:anchor` — page anchor for cross-linking (or `nil`)\n46\t    * `:preview` — optional 1-arity function returning HEEX\n47\t    * `:attrs` — list of attr maps introspected from the component\n48\t    * `:slots` — list of slot maps introspected from the component\n49\t    * `:line` — source line of the component definition (or `nil`)\n50\t    * `:data_component` — the canonical \"Module.function\" string for\n51\t      the `data-component` attribute on the rendered element\n52\t    * `:source` — relative source path (or `nil`)\n53\t  \"\"\"\n54\t\n55\t  @type entry :: %{\n56\t          required(:module) => module(),\n57\t          required(:function) => atom(),\n58\t          required(:category) => atom(),\n59\t          required(:label) => String.t(),\n60\t          required(:daisy_basis) => String.t() | nil,\n61\t          required(:summary) => String.t() | nil,\n62\t          required(:anchor) => String.t() | nil,\n63\t          required(:preview) => (map() -> Phoenix.LiveView.Rendered.t()) | nil,\n64\t          required(:attrs) => [attr_meta()],\n65\t          required(:slots) => [slot_meta()],\n66\t          required(:line) => integer() | nil,\n67\t          required(:data_component) => String.t(),\n68\t          required(:source) => String.t() | nil\n69\t        }\n70\t\n71\t  @type attr_meta :: %{\n72\t          required(:name) => String.t(),\n73\t          required(:type) => String.t(),\n74\t          required(:required) => boolean(),\n75\t          required(:default) => term() | nil,\n76\t          required(:values) => [String.t()] | nil,\n77\t          required(:doc) => String.t() | nil\n78\t        }\n79\t\n80\t  @type slot_meta :: %{\n81\t          required(:name) => String.t(),\n82\t          required(:required) => boolean(),\n83\t          required(:doc) => String.t() | nil\n84\t        }\n85\t\n86\t  @type category_spec :: {atom(), keyword()}\n87\t\n88\t  @callback entries() :: [entry()]\n89\t  @callback by_category() :: [{atom(), [entry()]}]\n90\t  @callback categories() :: [atom()]\n91\t  @callback category_label(atom()) :: String.t()\n92\t  @callback category_description(atom()) :: String.t()\n93\t  @callback fetch(module(), atom()) :: entry() | nil\n94\t\n95\t  @doc \"\"\"\n96\t  Tells `JobyKit.DaisyCatalogue` which daisy primitives this app wraps.\n97\t\n98\t  Optional. Declared as a callback so a misspelling (`daisy_override/0`)\n99\t  is a compile-time warning" <> ..., "chatcmpl-tool-bed860b4b2b28e28", ~U[2026-09-11 08:49:59.010269Z], "a90d4d0e-b988-4cfd-a206-25bd6d0d29f3"]
