INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 12, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "[benchapp/lib/benchapp_web/router.ex: 44 lines, showing 1–44]\n1\tdefmodule BenchappWeb.Router do\n2\t  use BenchappWeb, :router\n3\t\n4\t  pipeline :browser do\n5\t    plug :accepts, [\"html\"]\n6\t    plug :fetch_session\n7\t    plug :fetch_live_flash\n8\t    plug :put_root_layout, html: {BenchappWeb.Layouts, :root}\n9\t    plug :protect_from_forgery\n10\t    plug :put_secure_browser_headers\n11\t  end\n12\t\n13\t  pipeline :api do\n14\t    plug :accepts, [\"json\"]\n15\t  end\n16\t\n17\t  scope \"/\", BenchappWeb do\n18\t    pipe_through :browser\n19\t\n20\t    live \"/\", HomeLive, :index\n21\t    live \"/design\", DesignSystemLive, :index\n22\t    live \"/custom-designs\", CustomDesignsLive, :index\n23\t  end\n24\t\n25\t  scope \"/\" do\n26\t    pipe_through :api\n27\t\n28\t    get \"/design.json\", JobyKit.ManifestController, :show,\n29\t      private: %{joby_kit_manifest: BenchappWeb.DesignManifest}\n30\t  end\n31\t\n32\t  if Application.compile_env(:benchapp, :dev_routes) do\n33\t    import Phoenix.LiveDashboard.Router\n34\t\n35\t    scope \"/dev\" do\n36\t      pipe_through :browser\n37\t\n38\t      live_dashboard \"/dashboard\", metrics: BenchappWeb.Telemetry\n39\t\n40\t      forward \"/mailbox\", Plug.Swoosh.MailboxPreview\n41\t    end\n42\t  end\n43\tend\n44\t", "chatcmpl-tool-ab70798f0480f84c", ~U[2026-09-11 08:31:04.949662Z], "7e1b7ef0-48cd-4610-a0f6-ee3c7de1ad43"]
