INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 54, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "[benchapp/lib/benchapp_web/design_previews.ex: 74 lines, showing 1–32]\n1\tdefmodule BenchappWeb.DesignPreviews do\n2\t  @moduledoc \"\"\"\n3\t  Preview functions for **this app's** components, referenced by\n4\t  `BenchappWeb.DesignManifest`.\n5\t\n6\t  The kit's own components are previewed by `JobyKit.Previews`, so\n7\t  `/design` shows the same examples in every JobyKit app. You only write\n8\t  previews for what you add.\n9\t\n10\t  Each public function takes `assigns` (typically `%{}`) and returns a\n11\t  small HEEx rendering the component with sensible defaults. The\n12\t  manifest registers these via `preview: &BenchappWeb.DesignPreviews.X_preview/1`,\n13\t  and `JobyKit.SignatureComponent` invokes them inside the per-component\n14\t  card's collapsible Preview section.\n15\t\n16\t  Naming convention: every preview function ends in `_preview` so they\n17\t  don't collide with the imported component functions of the same name\n18\t  (e.g. `button` vs `button_preview`).\n19\t\n20\t  The previews call `JobyKit.CoreComponents` directly via the\n21\t  `CoreComponents` alias so the rendered HTML matches what the manifest\n22\t  declares — no dependency on the host's `<App>Web.CoreComponents`\n23\t  resolution.\n24\t  \"\"\"\n25\t\n26\t  use BenchappWeb, :html\n27\t\n28\t  alias JobyKit.CoreComponents\n29\t  alias BenchappWeb.CompositeComponents\n30\t\n31\t\n32\t\n[42 more lines — continue with offset: 33]", "chatcmpl-tool-81937c46dce015e4", ~U[2026-09-11 08:36:59.297699Z], "cd3cbe37-8086-48f2-8237-8bc552952b21"]
