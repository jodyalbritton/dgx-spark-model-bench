INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 2, "ok" => true, "tool" => "read"}, 32, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "[benchapp/deps/joby_kit/lib/joby_kit/lint.ex: 817 lines, showing 1–817]\n1\tdefmodule JobyKit.Lint do\n2\t  @moduledoc \"\"\"\n3\t  Lint engine for JobyKit-installed apps. Verifies wrapper-contract\n4\t  invariants by introspecting a manifest module and scanning the host's\n5\t  component source files.\n6\t\n7\t  ## Rules\n8\t\n9\t    * `:manifest_drift` (error) — a manifest entry points at a function\n10\t      that is not actually a Phoenix function component. Caught first\n11\t      because every other check depends on the entry being live.\n12\t    * `:missing_data_component` (error) — a registered wrapper does not\n13\t      carry `data-component=\"Module.function\"` in its source.\n14\t    * `:missing_rest_global` (warning) — a registered wrapper does not\n15\t      declare `attr :rest, :global`, blocking pass-through of phx-* and\n16\t      aria-* attributes from callers.\n17\t    * `:unregistered_wrapper` (warning) — a function carries a\n18\t      `data-component=\"...\"` attribute but is not registered in the\n19\t      manifest, making it invisible to `/design.json` and to agents.\n20\t    * `:raw_html_primitive` (warning) — a `.heex` template (or `~H`\n21\t      block in a `.ex`) contains a raw `<button>`, `<input>`,\n22\t      `<textarea>`, or `<select>` outside of a wrapper definition. The\n23\t      kit ships wrappers for all four; reaching past them drops the\n24\t      contract. Exempted per **enclosing `def`**: a function whose body\n25\t      carries `data-component=` is a wrapper, and raw primitives inside\n26\t      it are its own body. Commented-out markup is ignored. Per-line\n27\t      opt-out via `<%!-- jobykit:allow-raw-html --%>`.\n28\t    * `:forked_wrapper` (warning) — the app excludes a kit component\n29\t      from `import JobyKit.CoreComponents` and substitutes its own, so\n30\t      upstream fixes to that component never reach it.\n31\t    * `:duplicated_class_string` (warning) — the same long `class=\"...\"`\n32\t      string appears three or more times, which the kit's own guidance\n33\t      names as the signal that markup wants lifting into a wrapper.\n34\t    * `:unmarked_component` (warning) — a public function component\n35\t      renders markup but carries no `data-component` at all, so\n36\t      `:unregistered_wrapper` (which keys off that attribute) cannot see\n37\t      it. The most common way to skip the contract entirely.\n38\t    * `:assign_new_default` (error) — `assign_new(assigns, :x, ...)` on an\n39\t      attr declared with a `default:`. The key is always present, so the\n40\t      fallback is dead code. This shipped once as the flash nil-id bug.\n41\t\n42\t  Each violation is a map with `:rule`, `:severity`, `:message`,\n43\t  `:file`, `:line`, `:module`, `:function`. The engine is pure data —\n44\t  formatting and exit codes live in `Mix.Tasks.JobyKit.Lint`.\n45\t  \"\"\"\n46\t\n47\t  @type severity :: :error | :warning | :info\n48\t\n49\t  @type violation :: %{\n50\t          rule: atom(),\n51\t          severity: severity(),\n52\t          message: String.t(),\n53\t          file: String.t() | nil,\n54\t          line: non_neg_integer() | nil,\n55\t          module: module() | nil,\n56\t          function: atom() | nil\n57\t        }\n58\t\n59\t  @default_paths [\"lib/**/*.ex\", \"lib/**/*.heex\"]\n60\t  @data_component_re ~r/data-component=(?:\"([^\"]+)\"|'([^']+)')/\n61\t  # Deliberately case-sensitive: HEEx reserves lowercase tags for HTML and\n62\t  # capitalised ones for remote components, so `<Input.autocomplete />` is a\n63\t  # component call, not a raw `<input>`. Matching case-insensitively flagged\n64\t  # any host using a component module named Input/Select/Button.\n65\t  @raw_html_primitive_re ~r/<(button|input|textarea|select)\\b/\n66\t  @allow_raw_html_marker \"jobykit:allow-raw-html\"\n67\t\n68\t  # Defined here rather than beside heex_bearing?/2 because module\n69\t  # attributes must exist before the first use, and the component scans\n70\t  # below reference it.\n71\t  @sigil_h_re ~r/~H[\"'\\[\\(\\{<\\/\\|]/\n72\t\n73\t  @doc \"\"\"\n74\t  Run the lint engine. Returns a list of violations in deterministic\n75\t  order (drift first, then per-entry checks in manifest declaration\n76\t  order, then unregistered wrappers sorted by" <> ..., "chatcmpl-tool-8d31bad1d0366d45", ~U[2026-09-11 08:31:53.646130Z], "ad2a1468-2ffa-4d25-ae38-2a53bb3f56e9"]
