INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 17, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "[benchapp/lib/benchapp_web/live/home_live.ex: 151 lines, showing 1–151]\n1\tdefmodule BenchappWeb.HomeLive do\n2\t  @moduledoc \"\"\"\n3\t  Welcome page generated by `mix joby_kit.new`.\n4\t\n5\t  It doubles as the worked example: every block on it is built from a\n6\t  registered kit wrapper, and each section's eyebrow names the component\n7\t  that renders it. If you're an agent picking up this app, this page is\n8\t  the shortest correct answer to \"how do I build UI here\".\n9\t\n10\t  Edit freely — this file lives in your app, not in the kit. When you\n11\t  replace it, keep reaching for the wrappers it demonstrates.\n12\t  \"\"\"\n13\t\n14\t  use BenchappWeb, :live_view\n15\t\n16\t  @build_order [\n17\t    %{step: \"1\", rule: \"Domain composite exists?\", detail: \"Use it.\"},\n18\t    %{step: \"2\", rule: \"Generic composite exists?\", detail: \"Use it — see /custom-designs.\"},\n19\t    %{step: \"3\", rule: \"Core wrapper exists?\", detail: \"Use it — see /design.\"},\n20\t    %{\n21\t      step: \"4\",\n22\t      rule: \"daisyUI primitive exists?\",\n23\t      detail: \"Wrap it, register it in DesignManifest, then use it.\"\n24\t    },\n25\t    %{\n26\t      step: \"5\",\n27\t      rule: \"None of the above?\",\n28\t      detail: \"Tailwind plus theme tokens — then expose the result as a wrapper and register it.\"\n29\t    }\n30\t  ]\n31\t\n32\t  @lint_snippet \"\"\"\n33\t  # See what's already registered before building anything\n34\t  curl http://localhost:4000/design.json | jq '.components[].data_component'\n35\t\n36\t  # Then, after writing UI\n37\t  mix joby_kit.lint\\\n38\t  \"\"\"\n39\t\n40\t  @impl true\n41\t  def mount(_params, _session, socket) do\n42\t    {:ok,\n43\t     assign(socket,\n44\t       page_title: \"Home\",\n45\t       build_order: @build_order,\n46\t       lint_snippet: @lint_snippet\n47\t     )}\n48\t  end\n49\t\n50\t  @impl true\n51\t  def handle_event(_event, _params, socket), do: {:noreply, socket}\n52\t\n53\t  @impl true\n54\t  def render(assigns) do\n55\t    ~H\"\"\"\n56\t    <Layouts.app flash={@flash} active_nav=\"home\">\n57\t      <div class=\"mx-auto max-w-5xl space-y-14 px-4 py-12 sm:px-6\">\n58\t        <.header size=\"page\">\n59\t          Benchapp\n60\t          <:eyebrow>benchapp</:eyebrow>\n61\t          <:subtitle>\n62\t            A Phoenix app wired to JobyKit. Every UI primitive flows through a\n63\t            registered wrapper, so the component inventory, the rendered page, and\n64\t            the JSON manifest never drift apart.\n65\t          </:subtitle>\n66\t          <:actions>\n67\t            <.button navigate={~p\"/design\"} variant=\"primary\">Open the inventory</.button>\n68\t          </:actions>\n69\t        </.header>\n70\t\n71\t        <section class=\"space-y-4\">\n72\t          <.header level=\"h2\">\n73\t            Three surfaces\n74\t            <:eyebrow>Start here</:eyebrow>\n75\t            <:subtitle>\n76\t              Where the component inventory lives, for people and for agents.\n77\t              Each panel below is a <code class=\"font-mono text-xs\">&lt;.card&gt;</code>.\n78\t            </:subtitle>\n79\t          </.header>\n80\t\n81\t          <div class=\"grid gap-4 md:grid-cols-3\">\n82\t            <.card prose>\n83\t              <:eyebrow>Kit wrappers</:eyebrow>\n84\t              <:title><span class=\"font-mono text-base\">/design</span></:title>\n85\t              The curated inventory every JobyKit app shares, with the wrapper\n86\t              contract and the daisyUI catalogue.\n87\t              <:actions>\n88\t                <.button navigate={~p\"/design\"} size=\"sm\">Open</.button>\n89\t              </:actions>\n90\t            </.card>\n91\t\n92\t            <.card prose>\n93\t              <:eyebrow>This app's components</:eyebrow>\n94\t              <:title><span class=\"font-mono text-base\">/custom-designs</span></:title>\n95\t              Composites and domain components you add, starting from the worked\n96\t              empty-state example.\n97\t              <:actions>\n98\t                <.button navigate={~p\"/custom-designs\"} size=\"sm\">Open</.button>\n99\t              </:actions>\n100\t            </.card>\n101\t\n102\t            <.card prose>\n103\t              <:eyebrow>Machine-readable</:eyebrow>\n104\t              <:title><span class=\"font-mono text-base\">/design.json<" <> ..., "chatcmpl-tool-97261e1b8018a757", ~U[2026-09-11 08:31:16.398314Z], "a5e5b8f7-3131-4cff-a0bb-8f37170474a7"]
