INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"diff" => "+ defmodule BenchappWeb.AboutLive do\n+   @moduledoc \"\"\"\n+   Who JobyCorp is and why the work is shared.\n+   \"\"\"\n+ \n+   use BenchappWeb, :live_view\n+ \n+   @shared [\n+     %{artifact: \"records\", form: \"the full record of every run, fields and units intact\"},\n+     %{artifact: \"prompts\", form: \"the exact prompt set each result came from\"},\n+     %{artifact: \"method\", form: \"the protocol, versioned and kept fixed\"},\n+     %{artifact: \"hardware\", form: \"the device each run was measured on\"}\n+   ]\n+ \n+   @impl true\n+   def mount(_params, _session, socket) do\n+     {:ok, assign(socket, page_title: \"About\", shared: @shared)}\n+   end\n+ \n+   @impl true\n+   def render(assigns) do\n+     ~H\"\"\"\n+     <Layouts.app flash={@flash} active_nav=\"about\">\n+       <div class=\"mx-auto max-w-6xl px-6 md:px-8\">\n+         <section class=\"space-y-8 py-16 md:py-24\">\n+           <div class=\"max-w-prose space-y-5\">\n+             <h1 class=\"text-4xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-6xl\">\n+               A small lab that measures things\n+             </h1>\n+             <p class=\"text-base leading-relaxed text-base-content/70 md:text-lg\">\n+               JobyCorp is a local AI research company. We run language models on hardware we own,\n+               measure what they do, and share the work openly with the community that builds and\n+               uses these models.\n+             </p>\n+             <p class=\"text-base leading-relaxed text-base-content/70 md:text-lg\">\n+               We are not a product or a provider. The point of the work is the measurement: what a\n+               model actually does on a machine, described exactly enough for someone else to check\n+               it.\n+             </p>\n+           </div>\n+         </section>\n+ \n+         <section class=\"space-y-8 border-t border-base-300 py-16 md:py-24\">\n+           <div class=\"flex items-baseline gap-3\">\n+             <span class=\"font-mono text-sm text-base-content/70\">shared</span>\n+           </div>\n+           <div class=\"max-w-prose space-y-3\">\n+             <h2 class=\"text-3xl font-semibold tracking-tight md:text-4xl\">What we share</h2>\n+             <p class=\"text-base leading-relaxed text-base-content/70 md:text-lg\">\n+               Everything a result depends on goes out with the result. Not a headline number — the\n+               whole record.\n+             </p>\n+           </div>\n+           <div class=\"overflow-x-auto rounded-box border border-base-300\">\n+             <.table id=\"shared\" rows={@shared} zebra={false} class=\"[&>thead>tr>th]:bg-base-200\">\n+               <:col :let={s} label=\"artifact\">\n+                 <span class=\"font-mono text-sm\">{s.artifact}</span>\n+               </:col>\n+               <:col :let={s} label=\"what we publish\">\n+                 <span class=\"text-sm text-base-content/80\">{s.form}</span>\n+               </:col>\n+             </.table>\n+           </div>\n+         </section>\n+ \n+         <section class=\"space-y-8 border-t border-base-300 py-16 md:py-24\">\n+           <div class=\"max-w-prose space-y-3\">\n+             <h2 class=\"text-3xl font-semibold tracking-tight md:text-4xl\">Why we share it</h2>\n+           </div>\n+           <div class=\"max-w-prose space-y-4\">\n+             <.spec_row label=\"trust\">\n+               A number no one can check is worth little. Publishing the record lets a reader\n+               verify it or disagree on the evidence.\n+             </.spec_row>\n+             <.spec_row label=\"reproduce\">\n+               With the prompts, seeds, and hardware named, a result is a starting point rather\n+               than a claim to take on faith.\n+             </.spec_row>\n+             <.spec_row label=\"common ground\">\n+               Local models belong to a community. The measurements are meant to be a shared\n··· diff capped at 80 lines (+95 −0 in total)", "duration_ms" => 3, "lines_added" => 95, "lines_removed" => 0, "ok" => true, "tool" => "write"}, 70, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "wrote 3992 bytes to /Users/jody/dgx-spark-model-bench/results/2026-09-10-baseline/work/qwen38-flash-next-nvfp4/benchapp/lib/benchapp_web/live/about_live.ex", "chatcmpl-tool-85940b2ec0557d78", ~U[2026-09-11 08:43:01.768590Z], "4abbe296-1e35-42ea-9a80-ed6a84de5da7"]
