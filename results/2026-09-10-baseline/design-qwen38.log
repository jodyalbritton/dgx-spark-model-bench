INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 14, :tool, "bb749fdd-2e8e-4c43-900e-4984c7338aa3", "[benchapp/lib/benchapp_web/components/layouts.ex: 69 lines, showing 1–69]\n1\tdefmodule BenchappWeb.Layouts do\n2\t  @moduledoc \"\"\"\n3\t  Layouts for BenchappWeb. Generated by `mix joby_kit.new`.\n4\t\n5\t  Pages compose `<Layouts.app flash={@flash}>...` from inside their\n6\t  LiveView render and supply only their content — the nav, the theme\n7\t  control, the footer, and the flash container are wired in here so\n8\t  every page gets them for free.\n9\t\n10\t  The chrome owns its own surface: the sticky bar draws the background\n11\t  and border edge-to-edge, and `simple_nav/1` inside it draws neither.\n12\t  Splitting that between the two is what produces a seam where the\n13\t  centred nav's max-width ends.\n14\t  \"\"\"\n15\t  use BenchappWeb, :html\n16\t\n17\t  embed_templates \"layouts/*\"\n18\t\n19\t  attr :flash, :map, required: true\n20\t  attr :current_scope, :map, default: nil\n21\t  attr :active_nav, :string, default: nil\n22\t  slot :inner_block, required: true\n23\t\n24\t  def app(assigns) do\n25\t    ~H\"\"\"\n26\t    <div class=\"flex min-h-dvh flex-col bg-base-100\">\n27\t      <div class=\"sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur\">\n28\t        <div class=\"mx-auto w-full max-w-5xl px-4 sm:px-6\">\n29\t          <JobyKit.NavComponent.simple_nav active={@active_nav} brand=\"Benchapp\">\n30\t            <:actions>\n31\t              <JobyKit.CoreComponents.theme_toggle />\n32\t            </:actions>\n33\t          </JobyKit.NavComponent.simple_nav>\n34\t        </div>\n35\t      </div>\n36\t\n37\t      <main class=\"flex-1\">\n38\t        {render_slot(@inner_block)}\n39\t      </main>\n40\t\n41\t      <footer class=\"border-t border-base-300\">\n42\t        <div class=\"mx-auto flex max-w-5xl flex-col gap-3 px-4 py-6 text-xs text-base-content/60 sm:flex-row sm:items-center sm:justify-between sm:px-6\">\n43\t          <p>\n44\t            Benchapp · built with\n45\t            <.link\n46\t              href=\"https://github.com/jobycorp/joby_kit\"\n47\t              class=\"link link-hover font-medium\"\n48\t              target=\"_blank\"\n49\t              rel=\"noopener\"\n50\t            >\n51\t              JobyKit\n52\t            </.link>\n53\t          </p>\n54\t          <p class=\"flex gap-2 font-mono\">\n55\t            <.link navigate={~p\"/design\"} class=\"link link-hover\">/design</.link>\n56\t            <span aria-hidden=\"true\" class=\"opacity-40\">·</span>\n57\t            <.link navigate={~p\"/custom-designs\"} class=\"link link-hover\">/custom-designs</.link>\n58\t            <span aria-hidden=\"true\" class=\"opacity-40\">·</span>\n59\t            <.link href={~p\"/design.json\"} class=\"link link-hover\">/design.json</.link>\n60\t          </p>\n61\t        </div>\n62\t      </footer>\n63\t\n64\t      <JobyKit.CoreComponents.flash_group flash={@flash} />\n65\t    </div>\n66\t    \"\"\"\n67\t  end\n68\tend\n69\t", "chatcmpl-tool-ba8bc46960d9aaab", ~U[2026-09-11 08:31:10.768079Z], "54ad5abd-23e1-442d-bd4f-94997efb6d79"]
