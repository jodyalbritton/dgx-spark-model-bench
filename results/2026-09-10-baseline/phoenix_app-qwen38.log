INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 50, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[benchapp/deps/joby_kit/lib/joby_kit/core_components.ex: 1180 lines, showing 690–909]\n690\t      aria-label=\"Close\"\n691\t    >\n692\t      <.icon name=\"hero-x-mark\" class=\"size-4\" />\n693\t    </.button>\n694\t\n695\t    <h3 :if={@title != []} id={\"\#{@id}-title\"} class=\"text-lg font-semibold leading-tight\">\n696\t      {render_slot(@title)}\n697\t    </h3>\n698\t\n699\t    {render_slot(@body)}\n700\t\n701\t    <div :if={@actions != []} class=\"modal-action\">\n702\t      {render_slot(@actions)}\n703\t    </div>\n704\t    \"\"\"\n705\t  end\n706\t\n707\t  # -------------------------------------------------------- theme_toggle\n708\t\n709\t  # `active_class` is spelled out per entry rather than built from `value`.\n710\t  # Tailwind scans source as text and cannot evaluate interpolation — an\n711\t  # interpolated variant compiles to a literal `[data-theme=\#{theme}]`\n712\t  # rule, so the segments render but never highlight. Keep these literal.\n713\t  @themes [\n714\t    %{\n715\t      value: \"system\",\n716\t      icon: \"hero-computer-desktop\",\n717\t      label: \"Match system theme\",\n718\t      active_class:\n719\t        \"[[data-theme-source=system]_&]:text-primary [[data-theme-source=system]_&]:opacity-100\"\n720\t    },\n721\t    %{\n722\t      value: \"light\",\n723\t      icon: \"hero-sun\",\n724\t      label: \"Light theme\",\n725\t      active_class:\n726\t        \"[[data-theme-source=user][data-theme=light]_&]:text-primary \" <>\n727\t          \"[[data-theme-source=user][data-theme=light]_&]:opacity-100\"\n728\t    },\n729\t    %{\n730\t      value: \"dark\",\n731\t      icon: \"hero-moon\",\n732\t      label: \"Dark theme\",\n733\t      active_class:\n734\t        \"[[data-theme-source=user][data-theme=dark]_&]:text-primary \" <>\n735\t          \"[[data-theme-source=user][data-theme=dark]_&]:opacity-100\"\n736\t    }\n737\t  ]\n738\t\n739\t  @doc \"\"\"\n740\t  Segmented system / light / dark theme control.\n741\t\n742\t      <.theme_toggle />\n743\t\n744\t  Pairs with the theme script Phoenix puts in `root.html.heex`, which\n745\t  applies the stored choice before first paint and listens for the\n746\t  `phx:set-theme` event these buttons dispatch. Selection state is read\n747\t  straight off `<html data-theme>` / `data-theme-source` in CSS, so the\n748\t  control stays correct without round-tripping through the server.\n749\t\n750\t  Generated apps get this in their layout. If you are installing into an\n751\t  existing app, make sure `root.html.heex` carries that script — without\n752\t  it the buttons dispatch into nothing.\n753\t  \"\"\"\n754\t  attr :class, :any, default: nil\n755\t  attr :rest, :global\n756\t\n757\t  def theme_toggle(assigns) do\n758\t    assigns = assign(assigns, :themes, @themes)\n759\t\n760\t    ~H\"\"\"\n761\t    <div\n762\t      data-component=\"JobyKit.CoreComponents.theme_toggle\"\n763\t      class={[\"join\", @class]}\n764\t      role=\"group\"\n765\t      aria-label=\"Color theme\"\n766\t      {@rest}\n767\t    >\n768\t      <.button\n769\t        :for={theme <- @themes}\n770\t        type=\"button\"\n771\t        size=\"sm\"\n772\t        variant=\"ghost\"\n773\t        shape=\"square\"\n774\t        class={[\"join-item opacity-50 transition-opacity hover:opacity-80\", theme.active_class]}\n775\t        phx-click={JS.dispatch(\"phx:set-theme\")}\n776\t        data-phx-theme={theme.value}\n777\t        aria-label={theme.label}\n778\t        title={theme.label}\n779\t      >\n780\t        <.icon name={theme.icon} class=\"size-4\" />\n781\t      </.button>\n782\t    </div>\n783\t    \"\"\"\n784\t  end\n785\t\n786\t  # -------------------------------------------------------------- flash\n787\t\n788\t  @doc \"\"\"\n789\t  Renders a single flash notice as a daisyUI `alert`.\n790\t\n791\t  Positioning belongs to the container, not the notice: `flash_group/1`\n792\t  supplies the single `toast` that stacks every notice. Rendered on its\n793\t  own, `flash/1` sits inline wherever you put it.\n794\t\n795\t      <.flash kind={:info} flash={@flash} />\n796\t      <.flash kind={:error} title=\"Heads up\">Something happened</.flash>\n797\t  \"\"\"\n798\t  attr :id, :string, default: nil\n799\t  attr :flash, :map, default: %{}\n800\t  attr :title, :string, default: nil\n801\t\n802\t  attr :kind, :atom,\n803\t    values: [:info, :success, :warning, :error],\n804\t    required: true" <> ..., "chatcmpl-tool-9a087c87fb97f3c7", ~U[2026-09-11 07:50:56.865797Z], "f29ae9bf-597c-434b-a78f-6eb1fd2cf07c"]
