 oklch(96% 0.018 272.314);\n38\t  --color-accent: oklch(60% 0.25 292.717);\n39\t  --color-accent-content: oklch(96% 0.016 293.756);\n40\t  --color-neutral: oklch(37% 0.044 257.287);\n41\t  --color-neutral-content: oklch(98% 0.003 247.858);\n42\t  --color-info: oklch(58% 0.158 241.966);\n43\t  --color-info-content: oklch(97% 0.013 236.62);\n44\t  --color-success: oklch(60% 0.118 184.704);\n45\t  --color-success-content: oklch(98% 0.014 180.72);\n46\t  --color-warning: oklch(66% 0.179 58.318);\n47\t  --color-warning-content: oklch(98% 0.022 95.277);\n48\t  --color-error: oklch(58% 0.253 17.585);\n49\t  --color-error-content: oklch(96% 0.015 12.422);\n50\t  --radius-selector: 0.25rem;\n51\t  --radius-field: 0.25rem;\n52\t  --radius-box: 0.5rem;\n53\t  --size-selector: 0.21875rem;\n54\t  --size-field: 0.21875rem;\n55\t  --border: 1.5px;\n56\t  --depth: 1;\n57\t  --noise: 0;\n58\t}\n59\t\n60\t@plugin \"daisyui/packages/bundle/daisyui-theme\" {\n61\t  name: \"light\";\n62\t  default: true;\n63\t  prefersdark: false;\n64\t  color-scheme: \"light\";\n65\t  --color-base-100: oklch(98% 0 0);\n66\t  --color-base-200: oklch(96% 0.001 286.375);\n67\t  --color-base-300: oklch(92% 0.004 286.32);\n68\t  --color-base-content: oklch(21% 0.006 285.885);\n69\t  --color-primary: oklch(70% 0.213 47.604);\n70\t  --color-primary-content: oklch(98% 0.016 73.684);\n71\t  --color-secondary: oklch(55% 0.027 264.364);\n72\t  --color-secondary-content: oklch(98% 0.002 247.839);\n73\t  --color-accent: oklch(0% 0 0);\n74\t  --color-accent-content: oklch(100% 0 0);\n75\t  --color-neutral: oklch(44% 0.017 285.786);\n76\t  --color-neutral-content: oklch(98% 0 0);\n77\t  --color-info: oklch(62% 0.214 259.815);\n78\t  --color-info-content: oklch(97% 0.014 254.604);\n79\t  --color-success: oklch(70% 0.14 182.503);\n80\t  --color-success-content: oklch(98% 0.014 180.72);\n81\t  --color-warning: oklch(66% 0.179 58.318);\n82\t  --color-warning-content: oklch(98% 0.022 95.277);\n83\t  --color-error: oklch(58% 0.253 17.585);\n84\t  --color-error-content: oklch(96% 0.015 12.422);\n85\t  --radius-selector: 0.25rem;\n86\t  --radius-field: 0.25rem;\n87\t  --radius-box: 0.5rem;\n88\t  --size-selector: 0.21875rem;\n89\t  --size-field: 0.21875rem;\n90\t  --border: 1.5px;\n91\t  --depth: 1;\n92\t  --noise: 0;\n93\t}\n94\t\n95\t/* Add variants based on LiveView classes */\n96\t@custom-variant phx-click-loading (.phx-click-loading&, .phx-click-loading &);\n97\t@custom-variant phx-submit-loading (.phx-submit-loading&, .phx-submit-loading &);\n98\t@custom-variant phx-change-loa" <> ..., "chatcmpl-tool-b9dc8e1039b9dd58", ~U[2026-09-11 07:50:56.867799Z], "615142cf-afa4-406b-9f38-7f97cda36746"]
