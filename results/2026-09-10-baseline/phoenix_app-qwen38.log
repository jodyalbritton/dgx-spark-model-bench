INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 22, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[scratch/kit/contents/priv/templates/joby_kit.bootstrap/home_live.ex: 82 lines, showing 1–82]\n1\tdefmodule <%= @web_module %>.HomeLive do\n2\t  @moduledoc \"\"\"\n3\t  Clean welcome page generated by `mix joby_kit.bootstrap`. Composes\n4\t  the host's `<Layouts.app>` (so the existing nav, flash group, and\n5\t  chrome are reused) with content that points at /design and\n6\t  /custom-designs.\n7\t\n8\t  Edit freely — this file lives in your app, not in the kit.\n9\t  \"\"\"\n10\t\n11\t  use <%= @web_module %>, :live_view\n12\t\n13\t  @impl true\n14\t  def mount(_params, _session, socket) do\n15\t    {:ok, assign(socket, page_title: \"Home\")}\n16\t  end\n17\t\n18\t  @impl true\n19\t  def handle_event(_event, _params, socket), do: {:noreply, socket}\n20\t\n21\t  @impl true\n22\t  def render(assigns) do\n23\t    ~H\"\"\"\n24\t    <Layouts.app flash={@flash}>\n25\t      <main class=\"mx-auto max-w-4xl space-y-10 px-6 py-12\">\n26\t        <header class=\"space-y-3\">\n27\t          <p class=\"text-xs font-semibold uppercase tracking-[0.2em] text-base-content/50\">\n28\t            <%= @app %>\n29\t          </p>\n30\t          <h1 class=\"text-4xl font-semibold leading-tight\">\n31\t            Welcome to <%= @app_camel %>.\n32\t          </h1>\n33\t          <p class=\"max-w-2xl text-base text-base-content/75\">\n34\t            This app is bootstrapped with\n35\t            <a href=\"https://github.com/jobycorp/joby_kit\" class=\"link link-primary\" target=\"_blank\" rel=\"noopener\">\n36\t              JobyKit\n37\t            </a>, an opinionated, agentic-first design system on top of Phoenix and daisyUI.\n38\t            The two pages below are the discoverability surface for human and AI contributors.\n39\t          </p>\n40\t        </header>\n41\t\n42\t        <%!-- Fully qualified on purpose: bootstrap runs against an existing\n43\t        app whose `:html` helpers may still import its own CoreComponents,\n44\t        where <.card> does not exist. --%>\n45\t        <section class=\"grid gap-4 md:grid-cols-2\">\n46\t          <JobyKit.CoreComponents.card prose>\n47\t            <:title>Design system</:title>\n48\t            Kit-curated wrapper inventory, the wrapper contract, and the daisyUI catalogue.\n49\t            Same shape across every JobyKit consumer.\n50\t            <:actions>\n51\t              <JobyKit.CoreComponents.button navigate={~p\"/design\"} variant=\"primary\">\n52\t                Open /design\n53\t              </JobyKit.CoreComponents.button>\n54\t            </:actions>\n55\t          </JobyKit.CoreComponents.card>\n56\t\n57\t          <JobyKit.CoreComponents.card prose>\n58\t            <:title>Custom designs</:title>\n59\t            This app's generic composites and domain components — your team's\n60\t            additions to the catalogue.\n61\t            <:actions>\n62\t              <JobyKit.CoreComponents.button navigate={~p\"/custom-designs\"}>\n63\t                Open /custom-designs\n64\t              </JobyKit.CoreComponents.button>\n65\t            </:actions>\n66\t          </JobyKit.CoreComponents.card>\n67\t        </section>\n68\t\n69\t        <section class=\"space-y-3 rounded-2xl border border-base-300 bg-base-200/40 p-6\">\n70\t          <h2 class=\"text-lg font-semibold\">Manifest API for AI agents</h2>\n71\t          <p class=\"text-sm text-base-content/70\">\n72\t            The combined manifest (kit core + composites + domain) is served as JSON. Your\n73\t            coding agent can fetch it without parsing rendered HEEx.\n74\t          </p>\n75\t          <pre class=\"overflow-x-auto rounded-lg bg-base-300/40 p-4 text-xs\" phx-no-curly-interpolation><code>curl http://localhost:4000/design.json | jq</code></pre>\n76\t        </section>\n77\t      </main>\n78\t    </Layouts.app>\n79\t    \"\"\"\n80\t  end\n81\tend\n82\t", "chatcmpl-tool-9fbf9779b3a07b38", ~U[2026-09-11 07:49:49.351606Z], "6bca0e1f-201d-4065-8b88-3113fac369d6"]
