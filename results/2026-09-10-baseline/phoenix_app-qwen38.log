INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 26, "ok" => true, "tool" => "bash"}, 117, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "lazy_html\nlazy_html.ex\n17:  @doc \"\"\"\n23:  HTML document, use `from_fragment/1` instead.\n47:  @doc \"\"\"\n55:      iex> LazyHTML.from_fragment(~S|<a class=\"button\">Click me</a>|)\n62:      iex> LazyHTML.from_fragment(~S|<span>Hello</span> <span>world</span>|)\n74:  @spec from_fragment(String.t()) :: t()\n75:  def from_fragment(html) when is_binary(html) do\n76:    LazyHTML.NIF.from_fragment(html)\n79:  @doc ~S'''\n94:      iex> lazy_html = LazyHTML.from_fragment(~S|<span>Hello</span> <span>world</span>|)\n99:      ...>   LazyHTML.from_fragment(\"\"\"\n116:  @doc \"\"\"\n135:      iex> lazy_html = LazyHTML.from_fragment(~S|<div><!-- Link --><a href=\"https://elixir-lang.org\">Elixir</a></div>|)\n143:      iex> lazy_html = LazyHTML.from_fragment(~S|<div id=\"root\" class=\"layout\"></div>|)\n155:  @doc \"\"\"\n192:  @doc ~S'''\n202:      ...>   LazyHTML.from_fragment(\"\"\"\n232:      ...>   LazyHTML.from_fragment(\"\"\"\n257:  In the example above, each of the spans is first child of its\n265:  @doc ~S'''\n278:      ...>   LazyHTML.from_fragment(\"\"\"\n301:  @doc ~S'''\n307:      iex> lazy_html = LazyHTML.from_fragment(\"\"\"\n325:  def filter(%LazyHTML{} = lazy_html, selector) when is_binary(selector) do\n329:  @doc \"\"\"\n334:      iex> lazy_html = LazyHTML.from_fragment(~S|<div><span>Hello</span> <span>world</span></div>|)\n360:  @doc \"\"\"\n365:      iex> lazy_html = LazyHTML.from_fragment(~S|<div><span>Hello</span> <span>world</span></div>|)\n380:  @doc \"\"\"\n391:      iex> lazy_html = LazyHTML.from_fragment(~S|<div><span>1</span><span>2</span></div>|)\n", "chatcmpl-tool-b63c1f3a27bc0b96", ~U[2026-09-11 08:10:40.838853Z], "3af3697b-5f78-42a9-bece-eee653a55d46"]
