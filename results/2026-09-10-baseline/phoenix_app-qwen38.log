INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 43, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[benchapp/lib/benchapp_web/design_manifest.ex: 67 lines, showing 1–67]\n1\tdefmodule BenchappWeb.DesignManifest do\n2\t  @moduledoc \"\"\"\n3\t  This app's component manifest. Backed by `JobyKit.Manifest`.\n4\t\n5\t  This registers **this app's** components — the ones that surface on\n6\t  `/custom-designs`.\n7\t\n8\t  JobyKit registers its own, so `/design` shows the kit inventory\n9\t  without anything being listed here, and picks up new kit components\n10\t  when you upgrade the dependency rather than when someone remembers to\n11\t  edit this file. `/design.json` combines the kit's entries and yours,\n12\t  so agents still get one source of truth.\n13\t  \"\"\"\n14\t\n15\t  use JobyKit.Manifest\n16\t\n17\t  alias BenchappWeb.CompositeComponents\n18\t  alias BenchappWeb.DesignPreviews\n19\t\n20\t  category :composite,\n21\t    label: \"Generic composites\",\n22\t    description: \"Multi-primitive patterns reused across domains.\"\n23\t\n24\t  category :domain,\n25\t    label: \"Domain composites\",\n26\t    description: \"Composites tied to a product area.\"\n27\t\n28\t  # ----------------------------------------------------------------- composite\n29\t  # `empty_state` is the worked example — a real composite that bundles\n30\t  # `<.icon>` + a heading + an optional action slot. Use it as the\n31\t  # template for your own: copy the attr / slot / data-component shape,\n32\t  # register the entry here, and add a preview in `design_previews.ex`.\n33\t  #\n34\t  # Generic composites belong in `BenchappWeb.CompositeComponents`;\n35\t  # domain-specific ones in their own module (e.g.\n36\t  # `BenchappWeb.ChatComponents`).\n37\t\n38\t  component CompositeComponents, :empty_state,\n39\t    category: :composite,\n40\t    summary: \"Centered icon + title + optional action; fills empty containers.\",\n41\t    preview: &DesignPreviews.empty_state_preview/1\n42\t\n43\t  # -------------------------------------------------------------------- domain\n44\t  # Add domain composites here:\n45\t  #\n46\t  #   component BenchappWeb.ChatComponents, :composer,\n47\t  #     category: :domain,\n48\t  #     summary: \"Message composer with response-length controls.\"\n49\t\n50\t  @doc \"\"\"\n51\t  daisyUI primitives **this app** wraps that the kit does not.\n52\t\n53\t  The kit declares its own, so there is nothing to list here until you\n54\t  wrap a primitive yourself — a `drawer`, say, or a `carousel`. Entries\n55\t  here flip that primitive to \"Wrapped\" in the catalogue on `/design`\n56\t  and link to your component. Ids must match `JobyKit.DaisyCatalogue`\n57\t  ids.\n58\t\n59\t      def daisy_overrides do\n60\t        %{\n61\t          drawer: %{wrapper: \"<.app_drawer>\", anchor: \"#jobykit-component-...\"}\n62\t        }\n63\t      end\n64\t  \"\"\"\n65\t  def daisy_overrides, do: %{}\n66\tend\n67\t", "chatcmpl-tool-93907fc43109e801", ~U[2026-09-11 07:50:38.578602Z], "4edf1cb6-60ea-42ca-87e2-60e18963f652"]
