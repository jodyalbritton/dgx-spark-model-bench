INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 75, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[benchapp/deps/joby_kit/lib/joby_kit/core_components.ex: 1180 lines, showing 940–1079]\n940\t\n941\t  The wrapper carries **no outer margin**. Spacing belongs to the\n942\t  parent — reach for `space-y-*` or `gap-*` on the container.\n943\t\n944\t  Width works through the root: the control is always `w-full`, so\n945\t  constrain the root and the control follows.\n946\t\n947\t      <.input field={@form[:code]} class=\"w-32\" />\n948\t  \"\"\"\n949\t  attr :id, :any, default: nil\n950\t  attr :name, :any\n951\t  attr :label, :string, default: nil\n952\t  attr :value, :any\n953\t\n954\t  attr :type, :string,\n955\t    default: \"text\",\n956\t    values: ~w(checkbox color date datetime-local email file month number password\n957\t               search select tel text textarea time url week hidden)\n958\t\n959\t  attr :field, Phoenix.HTML.FormField\n960\t\n961\t  attr :errors, :list, default: []\n962\t  attr :checked, :boolean\n963\t  attr :prompt, :string, default: nil\n964\t  attr :options, :list\n965\t  attr :multiple, :boolean, default: false\n966\t\n967\t  attr :class, :any,\n968\t    default: nil,\n969\t    doc: \"Utilities for the root fieldset — layout, width, spacing.\"\n970\t\n971\t  attr :input_class, :any, default: nil, doc: \"Utilities for the control itself.\"\n972\t\n973\t  attr :rest, :global,\n974\t    include: ~w(accept autocomplete capture cols disabled form list max maxlength min minlength\n975\t                multiple pattern placeholder readonly required rows size step)\n976\t\n977\t  def input(%{field: %Phoenix.HTML.FormField{} = field} = assigns) do\n978\t    errors = if Phoenix.Component.used_input?(field), do: field.errors, else: []\n979\t\n980\t    assigns\n981\t    |> assign(field: nil, id: assigns.id || field.id)\n982\t    |> assign(:errors, Enum.map(errors, &translate_error/1))\n983\t    |> assign_new(:name, fn -> if assigns.multiple, do: field.name <> \"[]\", else: field.name end)\n984\t    |> assign_new(:value, fn -> field.value end)\n985\t    |> input()\n986\t  end\n987\t\n988\t  def input(%{type: \"hidden\"} = assigns) do\n989\t    ~H\"\"\"\n990\t    <input\n991\t      type=\"hidden\"\n992\t      data-component=\"JobyKit.CoreComponents.input\"\n993\t      id={@id}\n994\t      name={@name}\n995\t      value={@value}\n996\t      {@rest}\n997\t    />\n998\t    \"\"\"\n999\t  end\n1000\t\n1001\t  def input(%{type: \"checkbox\"} = assigns) do\n1002\t    assigns =\n1003\t      assign_new(assigns, :checked, fn ->\n1004\t        Phoenix.HTML.Form.normalize_value(\"checkbox\", assigns[:value])\n1005\t      end)\n1006\t\n1007\t    ~H\"\"\"\n1008\t    <fieldset class={[\"fieldset\", @class]} data-component=\"JobyKit.CoreComponents.input\">\n1009\t      <label for={@id}>\n1010\t        <input\n1011\t          type=\"hidden\"\n1012\t          name={@name}\n1013\t          value=\"false\"\n1014\t          disabled={@rest[:disabled]}\n1015\t          form={@rest[:form]}\n1016\t        />\n1017\t        <span class=\"label\">\n1018\t          <input\n1019\t            type=\"checkbox\"\n1020\t            id={@id}\n1021\t            name={@name}\n1022\t            value=\"true\"\n1023\t            checked={@checked}\n1024\t            class={[\"checkbox checkbox-sm\", @input_class]}\n1025\t            aria-invalid={@errors != [] && \"true\"}\n1026\t            aria-describedby={@errors != [] && error_id(@id)}\n1027\t            {@rest}\n1028\t          />{@label}\n1029\t        </span>\n1030\t      </label>\n1031\t      <.error_list errors={@errors} id={error_id(@id)} />\n1032\t    </fieldset>\n1033\t    \"\"\"\n1034\t  end\n1035\t\n1036\t  def input(%{type: \"select\"} = assigns) do\n1037\t    ~H\"\"\"\n1038\t    <fieldset class={[\"fieldset\", @class]} data-component=\"JobyKit.CoreComponents.input\">\n1039\t      <label for={@id}>\n1040\t        <span :if={@label} class=\"label\">{@label}</span>\n1041\t        <select\n1042\t          id={@id}\n1043\t          name={@name}\n1044\t          class={[\"w-full select\", @errors != [] && \"select-error\", @input_class]}\n1045\t          multiple={@multiple}\n1046\t          aria-invalid={@errors != [] && \"true\"}\n1047\t          aria-describedby={@errors != [] && error_id(@id)}\n1048\t          {@rest}\n1049\t        >\n1050\t          <option :if={@prompt} value=\"\">{@prompt}</option>\n1051\t          {Phoenix.HTML.Form.options_for_select(@optio" <> ..., "chatcmpl-tool-87131d372949c2b2", ~U[2026-09-11 07:58:03.689413Z], "4755e3ad-f9de-4537-9304-0c859a799e65"]
