INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 73, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[benchapp/deps/joby_kit/lib/joby_kit/core_components.ex: 1180 lines, showing 95–494]\n95\t  `<.button type=\"button\">`. Omitted, the browser default applies —\n96\t  `submit` inside a form.\n97\t\n98\t  ## Tone\n99\t\n100\t  `variant` carries meaning, not just colour — `danger` is how a\n101\t  destructive action reads as destructive:\n102\t\n103\t      <.button variant=\"danger\">Delete workspace</.button>\n104\t      <.button variant=\"ghost\">Dismiss</.button>\n105\t\n106\t  The default (`nil`) is the soft-primary treatment, also nameable as\n107\t  `soft` when the value is computed at runtime.\n108\t\n109\t  ## Icon-only buttons\n110\t\n111\t  `shape` sizes the button to a single glyph. Always give it an\n112\t  accessible name, since there is no text to read:\n113\t\n114\t      <.button shape=\"circle\" variant=\"ghost\" aria-label=\"Close\">\n115\t        <.icon name=\"hero-x-mark\" class=\"size-4\" />\n116\t      </.button>\n117\t  \"\"\"\n118\t  attr :rest, :global,\n119\t    include: ~w(href navigate patch method download name value disabled type form)\n120\t\n121\t  attr :class, :any, default: nil\n122\t\n123\t  attr :variant, :string,\n124\t    values: ~w(soft primary neutral ghost danger),\n125\t    doc: \"Tone. Defaults to the soft-primary treatment; `danger` for destructive actions.\"\n126\t\n127\t  attr :size, :string, values: ~w(xs sm md lg), default: \"md\", doc: \"Control height.\"\n128\t\n129\t  attr :shape, :string,\n130\t    values: ~w(circle square),\n131\t    doc: \"Square off an icon-only button. Give it an aria-label.\"\n132\t\n133\t  slot :inner_block, required: true\n134\t\n135\t  def button(%{rest: rest} = assigns) do\n136\t    variants = %{\n137\t      nil => \"btn-primary btn-soft\",\n138\t      \"soft\" => \"btn-primary btn-soft\",\n139\t      \"primary\" => \"btn-primary\",\n140\t      \"neutral\" => \"btn-neutral\",\n141\t      \"ghost\" => \"btn-ghost\",\n142\t      \"danger\" => \"btn-error\"\n143\t    }\n144\t\n145\t    sizes = %{\"xs\" => \"btn-xs\", \"sm\" => \"btn-sm\", \"md\" => nil, \"lg\" => \"btn-lg\"}\n146\t    shapes = %{nil => nil, \"circle\" => \"btn-circle\", \"square\" => \"btn-square\"}\n147\t\n148\t    assigns =\n149\t      assign(assigns, :class_list, [\n150\t        \"btn\",\n151\t        Map.fetch!(variants, assigns[:variant]),\n152\t        Map.fetch!(sizes, assigns.size),\n153\t        Map.fetch!(shapes, assigns[:shape]),\n154\t        assigns.class\n155\t      ])\n156\t\n157\t    if rest[:href] || rest[:navigate] || rest[:patch] do\n158\t      ~H\"\"\"\n159\t      <.link\n160\t        data-component=\"JobyKit.CoreComponents.button\"\n161\t        class={@class_list}\n162\t        {@rest}\n163\t      >\n164\t        {render_slot(@inner_block)}\n165\t      </.link>\n166\t      \"\"\"\n167\t    else\n168\t      ~H\"\"\"\n169\t      <button data-component=\"JobyKit.CoreComponents.button\" class={@class_list} {@rest}>\n170\t        {render_slot(@inner_block)}\n171\t      </button>\n172\t      \"\"\"\n173\t    end\n174\t  end\n175\t\n176\t  # ------------------------------------------------------------ eyebrow\n177\t\n178\t  @doc \"\"\"\n179\t  Small uppercase label that sits above a heading or leads a data pair.\n180\t\n181\t      <.eyebrow>Workspace</.eyebrow>\n182\t\n183\t  This is the most-duplicated string in the fleet: one app carried 326\n184\t  hand-typed instances of the same mono-uppercase treatment, with letter\n185\t  spacing drifting across nine values and six font sizes because every\n186\t  one was written by hand. One definition, one look.\n187\t\n188\t  `card/1` and `header/1` render their `:eyebrow` slots through this, so\n189\t  the three stay identical by construction.\n190\t  \"\"\"\n191\t  attr :class, :any, default: nil\n192\t  attr :rest, :global\n193\t  slot :inner_block, required: true\n194\t\n195\t  def eyebrow(assigns) do\n196\t    ~H\"\"\"\n197\t    <p\n198\t      data-component=\"JobyKit.CoreComponents.eyebrow\"\n199\t      class={[\n200\t        \"text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-base-content/55\",\n201\t        @class\n202\t      ]}\n203\t      {@rest}\n204\t    >\n205\t      {render_slot(@inner_block)}\n206\t    </p>\n207\t    \"\"\"\n208\t  end\n209\t\n210\t  # -------------------------------------------------------------- badge\n211\t\n212\t  @badge_tones %{\n213\t    \"neutral\" => \"badge-neutral\",\n214\t    \"ok\" => \"badge-success\",\n215\t    \"warn\"" <> ..., "chatcmpl-tool-aad3d67c8655ac27", ~U[2026-09-11 07:57:55.983304Z], "4bbb15ca-98b5-432c-bf72-946dc9a4913f"]
