INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 25, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[scratch/kit/contents/priv/templates/joby_kit.install/composite_components.ex: 84 lines, showing 1–84]\n1\tdefmodule <%= @web_module %>.CompositeComponents do\n2\t  @moduledoc \"\"\"\n3\t  Generic, multi-primitive composites for this app.\n4\t\n5\t  Composites live one layer above core wrappers: they bundle a small set\n6\t  of `JobyKit.CoreComponents` primitives into a higher-level pattern that\n7\t  appears more than once across the app. Examples: empty states, page\n8\t  headers with breadcrumbs, callouts, hero blocks.\n9\t\n10\t  Every composite follows the JobyKit wrapper contract:\n11\t\n12\t    1. Declare every prop with `attr` (use `values:` for variant enums).\n13\t    2. Carry `data-component=\"<%= @web_module %>.CompositeComponents.<name>\"`\n14\t       on the root element.\n15\t    3. Accept `attr :rest, :global` for id/class/aria-*/phx-* pass-through.\n16\t    4. Internals compose `JobyKit.CoreComponents` (or other registered\n17\t       wrappers) — never raw `<button>`/`<input>`/`<textarea>`.\n18\t    5. Register the composite in `<%= @web_module %>.DesignManifest`\n19\t       (`category: :composite`) so it surfaces on `/custom-designs` and\n20\t       in `/design.json`.\n21\t\n22\t  The `empty_state/1` below ships pre-registered as a worked example.\n23\t  Use it as a template when you add your own composites: copy the\n24\t  attribute / slot / `data-component` shape, then register the new entry\n25\t  in the manifest.\n26\t  \"\"\"\n27\t\n28\t  use <%= @web_module %>, :html\n29\t\n30\t  alias JobyKit.CoreComponents\n31\t\n32\t  @doc \"\"\"\n33\t  An empty-state callout: centered icon, title, supporting text, and an\n34\t  optional action slot. Use to fill an otherwise-empty container — an\n35\t  unfilled list, a search with no results, a fresh dashboard.\n36\t\n37\t      <.empty_state icon=\"hero-inbox\" title=\"No messages yet\">\n38\t        Start a conversation with a teammate to see it here.\n39\t        <:action>\n40\t          <CoreComponents.button variant=\"primary\">New message</CoreComponents.button>\n41\t        </:action>\n42\t      </.empty_state>\n43\t  \"\"\"\n44\t  attr :icon, :string,\n45\t    default: \"hero-sparkles\",\n46\t    doc: \"Heroicon name to display above the title.\"\n47\t\n48\t  attr :title, :string, required: true\n49\t  attr :tone, :string, values: ~w(neutral primary), default: \"neutral\"\n50\t  attr :rest, :global\n51\t\n52\t  slot :inner_block, doc: \"Supporting copy beneath the title.\"\n53\t  slot :action, doc: \"Optional call-to-action (typically a `<.button>`).\"\n54\t\n55\t  def empty_state(assigns) do\n56\t    ~H\"\"\"\n57\t    <div\n58\t      data-component=\"<%= @web_module %>.CompositeComponents.empty_state\"\n59\t      class={[\n60\t        \"flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed px-6 py-10 text-center\",\n61\t        @tone == \"neutral\" && \"border-base-300 bg-base-100/40 text-base-content/70\",\n62\t        @tone == \"primary\" && \"border-primary/30 bg-primary/5 text-base-content\"\n63\t      ]}\n64\t      {@rest}\n65\t    >\n66\t      <span class={[\n67\t        \"flex size-12 items-center justify-center rounded-full\",\n68\t        @tone == \"neutral\" && \"bg-base-200 text-base-content/60\",\n69\t        @tone == \"primary\" && \"bg-primary/10 text-primary\"\n70\t      ]}>\n71\t        <CoreComponents.icon name={@icon} class=\"size-6\" />\n72\t      </span>\n73\t      <h3 class=\"text-base font-semibold text-base-content\">{@title}</h3>\n74\t      <div :if={@inner_block != []} class=\"max-w-sm text-sm text-base-content/65\">\n75\t        {render_slot(@inner_block)}\n76\t      </div>\n77\t      <div :if={@action != []} class=\"pt-1\">\n78\t        {render_slot(@action)}\n79\t      </div>\n80\t    </div>\n81\t    \"\"\"\n82\t  end\n83\tend\n84\t", "chatcmpl-tool-8c63b13df3e3ce45", ~U[2026-09-11 07:49:54.851525Z], "15e7812a-acf9-442a-97e6-da705728ff00"]
