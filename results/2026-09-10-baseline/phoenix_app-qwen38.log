INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 0, "ok" => true, "tool" => "read"}, 57, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[benchapp/deps/joby_kit/lib/joby_kit/page_component.ex: 479 lines, showing 1–120]\n1\tdefmodule JobyKit.PageComponent do\n2\t  @moduledoc \"\"\"\n3\t  Function components that render the JobyKit design surfaces.\n4\t\n5\t  Two surfaces are exposed:\n6\t\n7\t    * `page_component/1` — JobyKit's curated `/design` page. Renders the\n8\t      decision tree, wrapper contract, **every entry whose module the kit\n9\t      owns**, and the daisyUI catalogue. Identical across every JobyKit\n10\t      consumer; this is the agentic-first contract surface.\n11\t\n12\t    * `custom_page_component/1` — host-defined composites and domain\n13\t      components. Renders **every entry the kit does not own**, plus a\n14\t      slim breadcrumb back to `/design`. Hosts mount this at any path\n15\t      they like (`/custom-designs`, `/composites`, etc.).\n16\t\n17\t  The split is by module ownership, not by declared category. Category is\n18\t  a host-chosen atom, so keying the pages off it meant an app could\n19\t  register its own component as `:core` and have it appear on the kit's\n20\t  page as though JobyKit shipped it. Category now groups entries within\n21\t  whichever page owns them.\n22\t\n23\t  Both consume the same manifest module (`use JobyKit.Manifest`) but\n24\t  filter differently. The JSON endpoint\n25\t  (`JobyKit.ManifestController`) returns *all* entries — kit core +\n26\t  composites + domain — so agents have a single source of truth.\n27\t\n28\t  Hosts wrap these components in their own LiveView render and supply\n29\t  page chrome (layout, headers, navigation).\n30\t  \"\"\"\n31\t\n32\t  use Phoenix.Component\n33\t\n34\t  alias JobyKit.Contract\n35\t  alias JobyKit.DaisyCatalogue\n36\t  alias JobyKit.SignatureComponent\n37\t\n38\t  attr :manifest, :atom, required: true\n39\t  attr :custom_path, :string, default: nil\n40\t\n41\t  def page_component(assigns) do\n42\t    # The kit's own manifest, not the host's. The host's manifest still\n43\t    # supplies daisy_overrides below, since an app can wrap primitives\n44\t    # the kit doesn't.\n45\t    entries_by_category = JobyKit.KitManifest.by_category()\n46\t\n47\t    assigns =\n48\t      assigns\n49\t      |> assign(:entries_by_category, entries_by_category)\n50\t      |> assign(:catalogue, DaisyCatalogue.merged(assigns.manifest))\n51\t      |> assign(:build_order, Contract.build_order())\n52\t      |> assign(:rules, Contract.rules())\n53\t      |> assign(:taxonomy, Contract.taxonomy())\n54\t\n55\t    ~H\"\"\"\n56\t    <div class=\"space-y-8\" data-jobykit-page=\"kit\">\n57\t      <.decision_tree_section build_order={@build_order} taxonomy={@taxonomy} />\n58\t      <.agent_redirect_section :if={@custom_path} custom_path={@custom_path} />\n59\t      <.wrapper_contract_section rules={@rules} />\n60\t      <.component_index_section\n61\t        manifest={JobyKit.KitManifest}\n62\t        entries_by_category={@entries_by_category}\n63\t        title=\"Core wrappers\"\n64\t        description=\"JobyKit's curated wrapper inventory — one wrapper per daisyUI primitive. Composites and domain components live on the host's custom-designs page and in the JSON manifest.\"\n65\t      />\n66\t      <.daisy_catalogue_section catalogue={@catalogue} />\n67\t    </div>\n68\t    \"\"\"\n69\t  end\n70\t\n71\t  attr :custom_path, :string, required: true\n72\t\n73\t  defp agent_redirect_section(assigns) do\n74\t    ~H\"\"\"\n75\t    <section\n76\t      id=\"design-system-agent-redirect\"\n77\t      data-jobykit-section=\"agent-redirect\"\n78\t      class=\"rounded-2xl border border-warning/40 bg-warning/10 p-5\"\n79\t    >\n80\t      <p class=\"text-xs uppercase tracking-[0.18em] text-warning/85\">Adding a new component?</p>\n81\t      <h3 class=\"mt-2 text-lg font-semibold text-base-content\">\n82\t        Don't add it here. Register it on the custom-designs page instead.\n83\t      </h3>\n84\t      <p class=\"mt-2 max-w-3xl text-sm leading-relaxed text-base-content/75\">\n85\t        This page is the kit's curated catalogue — every JobyKit consumer sees the same\n86\t        wrapper inventory and contract. App-specific components don't belong here.\n87\t        Register them in this app's manifest with category\n88\t        <code class=\"font-mono text-xs\">:composite</code> or\n89\t        <code class=\"" <> ..., "chatcmpl-tool-81af13433f11a203", ~U[2026-09-11 07:53:47.231719Z], "2a23b9d6-d183-4108-ae62-ab9d0f5e28f6"]
