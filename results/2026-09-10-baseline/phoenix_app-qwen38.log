INSERT INTO "messages" ("meta","seq","role","session_id","content","tool_call_id","inserted_at","id") VALUES ($1,$2,$3,$4,$5,$6,$7,$8) [%{"duration_ms" => 1, "ok" => true, "tool" => "read"}, 54, :tool, "4e0d427e-222d-494e-94c1-e4bae425157b", "[benchapp/test/support/conn_case.ex: 39 lines, showing 1–39]\n1\tdefmodule BenchappWeb.ConnCase do\n2\t  @moduledoc \"\"\"\n3\t  This module defines the test case to be used by\n4\t  tests that require setting up a connection.\n5\t\n6\t  Such tests rely on `Phoenix.ConnTest` and also\n7\t  import other functionality to make it easier\n8\t  to build common data structures and query the data layer.\n9\t\n10\t  Finally, if the test case interacts with the database,\n11\t  we enable the SQL sandbox, so changes done to the database\n12\t  are reverted at the end of every test. If you are using\n13\t  PostgreSQL, you can even run database tests asynchronously\n14\t  by setting `use BenchappWeb.ConnCase, async: true`, although\n15\t  this option is not recommended for other databases.\n16\t  \"\"\"\n17\t\n18\t  use ExUnit.CaseTemplate\n19\t\n20\t  using do\n21\t    quote do\n22\t      # The default endpoint for testing\n23\t      @endpoint BenchappWeb.Endpoint\n24\t\n25\t      use BenchappWeb, :verified_routes\n26\t\n27\t      # Import conveniences for testing with connections\n28\t      import Plug.Conn\n29\t      import Phoenix.ConnTest\n30\t      import BenchappWeb.ConnCase\n31\t    end\n32\t  end\n33\t\n34\t  setup tags do\n35\t    Benchapp.DataCase.setup_sandbox(tags)\n36\t    {:ok, conn: Phoenix.ConnTest.build_conn()}\n37\t  end\n38\tend\n39\t", "chatcmpl-tool-918196745abd3a3b", ~U[2026-09-11 07:53:37.909017Z], "86df6a15-0dec-46cc-a2ed-7b022568c9ef"]
