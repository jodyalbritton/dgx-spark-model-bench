+  @doc """
+  A responsive grid of feature cards. Each entry is a map with `:icon`,
+  `:title` and `:text` keys; the grid collapses to one column at phone
+  widths and spreads to two or four columns above that.
+
+      <.feature_grid features={[
+        %{icon: "hero-bolt", title: "Instant on", text: "Wakes in 80 ms."},
+        %{icon: "hero-moon", title: "Night warm", text: "Melatonin-safe glow."}
+      ]} />
+  """
+  attr :features, :list,
+    required: true,
+    doc: "List of %{icon: heroicon name, title: string, text: string}."
+
+  attr :columns, :string,
+    values: ~w(2 3 4),
+    default: "3",
+    doc: "Column count at md widths and above."
+
+  attr :rest, :global
+
+  def feature_grid(assigns) do
+    assigns = assign(assigns, :col_class, column_class(assigns.columns))
+
+    ~H"""
+    <div
+      data-component="BenchappWeb.CompositeComponents.feature_grid"
+      class={["grid gap-4 sm:grid-cols-2", @col_class]}
+      {@rest}
+    >
+      <JobyKit.CoreComponents.card :for={feature <- @features}>
+        <:eyebrow>{feature.title}</:eyebrow>
+        <span class="mb-2 flex size-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
+          <JobyKit.CoreComponents.icon name={feature.icon} class="size-5" />
+        </span>
+        <p class="text-sm text-base-content/70">{feature.text}</p>
+      </JobyKit.CoreComponents.card>
+    </div>
+    """
+  end
+
+  defp column_class("2"), do: "md:grid-cols-2"
+  defp column_class("3"), do: "md:grid-cols-3"
+  defp column_class("4"), do: "md:grid-cols-4"
 end
